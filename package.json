{
  "name": "astro-paper",
  "version": "4.2.0",
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-content-images.mjs && astro build && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "cz": "cz",
    "prepare": "husky install",
    "lint": "eslint .",
    "check": "node scripts/check-content-images.mjs && node scripts/check-types.mjs",
    "security:runtime": "node scripts/check-security-runtime.mjs",
    "security:browser": "node scripts/check-security-browser.mjs",
    "validate": "npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.0",
    "astro": "^7.3.3",
    "fuse.js": "^7.0.0",
    "github-slugger": "^2.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.10.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "autoprefixer": "10.4.17",
    "@divriots/jampack": "^0.23.2",
    "@tailwindcss/typography": "^0.5.10",
    "@types/github-slugger": "^1.3.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/parser": "^8.72.0",
    "astro-eslint-parser": "^0.16.2",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^0.31.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "playwright": "1.64.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  },
  "overrides": {
    "@divriots/jampack": {
      "sharp": "0.35.5",
      "undici": "6.29.1",
      "esbuild": "0.25.12",
      "file-type": "21.3.4",
      "svgo": "3.3.5"
    },
    "ajv@^6": "6.15.0",
    "brace-expansion@^1": "1.1.21",
    "braces@^3": "3.0.3",
    "cross-spawn@^7": "7.0.6",
    "diff@^4": "4.0.4",
    "fflate@^0.7": "0.7.5",
    "flatted@^3": "3.4.4",
    "lodash@^4": "4.18.1",
    "mdast-util-to-hast@^13": "13.2.1",
    "micromatch@^4": "4.0.8",
    "minimatch@^3": "3.1.5",
    "picomatch@^2": "2.3.2",
    "postcss-selector-parser@<7.1.6": "7.1.7",
    "tmp@<0.2.6": "0.2.7",
    "yaml@^2": "2.9.1"
  }
}
