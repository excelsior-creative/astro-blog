---
export interface Props {
  href: string;
  className?: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
}

const {
  href,
  className,
  class: scopedClass,
  ariaLabel,
  title,
  disabled = false,
  ...attributes
} = Astro.props;
---

{
  disabled ? (
    <span
      {...attributes}
      class:list={["group inline-block", className, scopedClass]}
      aria-label={ariaLabel}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      {...attributes}
      {href}
      class:list={[
        "group inline-block hover:text-skin-accent",
        className,
        scopedClass,
      ]}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </a>
  )
}
